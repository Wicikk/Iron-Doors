local SimpleSound = {}
local Sounds = {}

local function safeName(name)
	assert(type(name) == "string" and #name > 0, "SimpleSound: name must be a non-empty string")
	assert(not name:find("[/\\]"), "SimpleSound: name must not contain path separators")
	assert(not name:find("%.%."), "SimpleSound: name must not contain '..'")
	return name
end

function SimpleSound.Load(name, url)
	name = safeName(name)
	assert(type(url) == "string" and url:match("^https://"), "SimpleSound: url must be an https:// string")

	local soundtrack = name .. ".mp3"

	if not isfile(soundtrack) then
		writefile(soundtrack, game:HttpGet(url))
	end
end

function SimpleSound.Play(name, looped)
	name = safeName(name)

	if Sounds[name] then
		Sounds[name]:Stop()
	end

	local Sound = Instance.new("Sound")
	Sound.SoundId = getcustomasset(name .. ".mp3")
	Sound.Volume = 1
	Sound.Looped = looped or false
	Sound.Parent = game.Players.LocalPlayer.Character.HumanoidRootPart
	Sound:Play()

	Sounds[name] = Sound
end

function SimpleSound.Stop(name)
	if Sounds[name] then
		Sounds[name]:Stop()
	end
end

function SimpleSound.StopAll()
	for K, V in Sounds do
		V:Stop()
	end
end

function SimpleSound.SetVolume(name, volume)
	if Sounds[name] then
		Sounds[name].Volume = volume
	end
end

return SimpleSound
